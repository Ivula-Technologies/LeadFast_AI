# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Public URL of this app (used in Stripe redirects and lead emails)
NEXT_PUBLIC_APP_URL=https://leadfast.ivulatechnologies.com

# --- AI replies (Gemini first, Claude as fallback; either is enough) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5
ANTHROPIC_MODEL=

# --- Email (Resend). FROM must be on a domain verified in Resend. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=replies@leadfast.ivulatechnologies.com

# --- Stripe billing ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
# Free trial length in days (no card required)
TRIAL_DAYS=14

# Optional: business that receives leads from the hosted /contact form
# when no business ID is given (e.g. LeadFast's own sales inbox).
LEADFAST_DEFAULT_BUSINESS_ID=

# Reverse proxies in front of the app (cPanel/Apache = 1). Used to read the
# real client IP for rate limiting; raise only if you add Cloudflare etc.
TRUSTED_PROXY_HOPS=1

# Shared secret for /api/cron/trial-reminders (cPanel cron sends it as a Bearer token)
CRON_SECRET=
# Optional: where replies to trial reminder emails go
SUPPORT_EMAIL=

# Phone alerts for new leads (optional). Generate with: node scripts/vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@ivula.co.ke
